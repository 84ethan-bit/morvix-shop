{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(summer|kitchen|clean|car|life)/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/:slug(fan001|blanket001|car001|mosquito001)",
      "destination": "/index.html"
    }
  ]
}
