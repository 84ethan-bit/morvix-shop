{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(summer|kitchen|clean|car|life)/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(fan001|blanket001|car001|mosquito001)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
