{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(summer|kitchen|clean|car|life)/(.*)",
      "dest": "/index.html#$1/$2"
    },
    {
      "src": "/(fan001|blanket001|car001|mosquito001)",
      "dest": "/index.html#$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
